<?xml version="1.0"?>
<!--
  Extra handle voor Catalog > Products in de snelle stand (cookie lucky_fastgrids_products=1).
  Het UI-grid wordt niet gerenderd; het blok "products_list" (knop Add Product) blijft staan.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Lucky_FastGrids::css/fastgrids.css"/>
        <script src="Lucky_FastGrids::js/grid.js"/>
        <script src="Lucky_FastGrids::js/products.js"/>
    </head>
    <body>
        <referenceBlock name="product_listing" remove="true"/>
        <referenceBlock name="product_list_url_filter_applier" remove="true"/>
        <referenceContainer name="page.main.actions">
            <block class="Lucky\FastGrids\Block\Adminhtml\GridButtons" name="lucky_fastgrids_products_buttons" before="-">
                <arguments>
                    <argument name="grid" xsi:type="string">product_listing</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Lucky\FastGrids\Block\Adminhtml\Products" name="lucky.fastgrids.products" template="Lucky_FastGrids::products.phtml"/>
        </referenceContainer>
    </body>
</page>
