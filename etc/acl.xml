<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Sales::sales">
                    <resource id="Magento_Sales::sales_operation">
                        <resource id="Lucky_FastGrids::orders" title="Orders Fast" sortOrder="15"/>
                    </resource>
                </resource>
                <resource id="Magento_Customer::customer">
                    <resource id="Lucky_FastGrids::customers" title="Customers Fast" sortOrder="15"/>
                </resource>
                <resource id="Magento_Catalog::catalog">
                    <resource id="Magento_Catalog::catalog_inventory">
                        <resource id="Lucky_FastGrids::products" title="Products Fast" sortOrder="15"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Lucky_FastGrids::config" title="Fast Grids" sortOrder="400"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
